local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local ColdCallFeedback = Remotes:WaitForChild("ColdCallFeedback")

-- Phone refs
local phoneModel = workspace:WaitForChild("Phone")
local telephone = phoneModel:WaitForChild("Telephone")

local prompt = telephone:WaitForChild("ProximityPrompt") -- ✅ ADD THIS

local sfxDial = telephone:FindFirstChild("SFX_Dial")
local sfxSuccess = telephone:FindFirstChild("SFX_Success")
local sfxFail = telephone:FindFirstChild("SFX_Fail")

local highlight = telephone:FindFirstChildWhichIsA("Highlight")

-- Make dial loop while holding
if sfxDial then
	sfxDial.Looped = true -- ✅ ADD THIS
end

-- HUD Toast
local playerGui = player:WaitForChild("PlayerGui")
local hud = playerGui:WaitForChild("HUD")
local toast = hud:WaitForChild("Toast")

local toastTweenIn = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local toastTweenOut = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

local function showToast(text)
	toast.Text = text
	toast.Visible = true
	toast.TextTransparency = 1
	toast.BackgroundTransparency = 1

	TweenService:Create(toast, toastTweenIn, {TextTransparency = 0, BackgroundTransparency = 0.2}):Play()
	task.delay(1.2, function()
		TweenService:Create(toast, toastTweenOut, {TextTransparency = 1, BackgroundTransparency = 1}):Play()
		task.delay(0.2, function()
			toast.Visible = false
		end)
	end)
end

local function stopDial()
	if sfxDial and sfxDial.IsPlaying then
		sfxDial:Stop()
	end
end

-- ✅ START dial when player begins holding E
prompt.PromptButtonHoldBegan:Connect(function(plr)
	if plr ~= player then return end
	if sfxDial and not sfxDial.IsPlaying then
		sfxDial:Play()
	end
end)

-- ✅ STOP dial if player releases early / cancels
prompt.PromptButtonHoldEnded:Connect(function(plr)
	if plr ~= player then return end
	stopDial()
end)

-- Server result (success/fail) + stop dial
ColdCallFeedback.OnClientEvent:Connect(function(resultType, message)
	stopDial() -- ✅ ADD THIS (ensures dial stops after hold completes)

	if resultType == "success" then
		if sfxSuccess then sfxSuccess:Play() end
		if highlight then
			highlight.Enabled = true
			task.delay(0.95, function()
				highlight.Enabled = false
			end)
		end
	else
		if sfxFail then sfxFail:Play() end
	end

	showToast(message)
end)
